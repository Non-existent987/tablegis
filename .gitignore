# TableGIS specific ignores
tablegis.egg-info/
dist/
# tablegis local dirs
.parquet_cache/
.workbuddy/

# re-include vendored libdeflate core sources (generic lib/ rule above would exclude them)
!tablegis/src/libdeflate/lib/

# re-include vendored libdeflate cmake templates (generic *.in rule above excludes them)
!tablegis/src/libdeflate/**/*.in
